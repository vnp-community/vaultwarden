{
	"info": {
		"_postman_id": "vaultwarden-collection-v1",
		"name": "Vaultwarden API",
		"description": "Collection for testing Vaultwarden API endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Identity",
			"item": [
				{
					"name": "Prelogin",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{ \"email\": \"{{username}}\" }",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/identity/accounts/prelogin",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"identity",
								"accounts",
								"prelogin"
							]
						}
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"access_token\", jsonData.access_token);",
									"pm.environment.set(\"refresh_token\", jsonData.refresh_token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "password",
									"type": "text"
								},
								{
									"key": "username",
									"value": "{{username}}",
									"type": "text"
								},
								{
									"key": "password",
									"value": "{{password_hash}}",
									"type": "text"
								},
								{
									"key": "scope",
									"value": "api offline_access",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "web",
									"type": "text"
								},
								{
									"key": "device_identifier",
									"value": "{{device_uuid}}",
									"type": "text"
								},
								{
									"key": "device_name",
									"value": "Postman",
									"type": "text"
								},
								{
									"key": "device_type",
									"value": "2",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/identity/connect/token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"identity",
								"connect",
								"token"
							]
						}
					},
					"response": []
				}
			]
		},
